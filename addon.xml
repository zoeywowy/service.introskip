<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.introskip" name="IntroSkip" version="0.0.23" provider-name="zoeywowy">
    <requires>
        <import addon="xbmc.python" version="3.1.1"/>
        <import addon="script.module.requests"/>
    </requires>
    
    <!-- Service that runs in background -->
    <extension point="xbmc.service" library="service.py" start="startup"/>
    
    <!-- Script that opens settings when clicked (no UI window) -->
    <extension point="xbmc.python.script" library="main.py">
        <provides>executable</provides>
    </extension>
    
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Skip intros, recaps and credits with IntroDB and native Kodi 22 chapters, plus modern customizable PNG prompts.</summary>
        <description lang="en_GB"></description>
        <language></language>
        <platform>all</platform>
        <license>Apache-2.0</license>
        <forum></forum>
        <website>https://github.com/zoeywowy</website>
        <email></email>
        <source></source>
        <news>0.0.23 replaces OMDb and Kodi library-ID lookups with keyless Cinemeta title searches for movies and TV series. Removes Advanced diagnostics and OMDb configuration; retains Kodi 22 chapters, playback-only IntroDB timestamps, and Light/Dark button color palettes. No TVDB, OMDb, or persistent timestamp cache.</news>
        <disclaimer></disclaimer>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>